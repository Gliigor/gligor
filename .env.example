# Copy to .env.local for local development. Never commit real values.
# On Vercel: Project > Settings > Environment Variables.

# Required for real replies. Create one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Optional: a shared code visitors must enter before Vee answers.
# Leave empty to let anyone use the tryout (they will spend your API budget).
VEE_ACCESS_CODE=

# Optional: set to 1 to force canned replies even when a key is present.
VEE_MOCK=

# Optional model overrides (defaults live in api/_lib/models.ts).
# VEE_MODEL_FAST=claude-haiku-4-5-20251001
# VEE_MODEL_SMART=claude-opus-5-5

# Optional (frontend): where the API lives if it is NOT on the same domain.
# Leave empty when the site and the API are both on Vercel.
# VITE_VEE_API_BASE=https://your-project.vercel.app
