# Copy this file to .env.local and fill in the values (README.md, step 3).
# .env.local is never committed.

# Supabase → Project Settings → API (or the "Connect" button).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Secret key (Supabase → Project Settings → API Keys → "Secret keys").
# Server-only. Needed for `npm run seed` and for sending invitation e-mails.
# Never prefix it with NEXT_PUBLIC_ and never share it.
SUPABASE_SECRET_KEY=sb_secret_...

# Public address of the app, used in e-mail links. Locally: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Hostname that serves the super admin dashboard (no protocol).
# Production: admin.gligor.xyz   Locally: admin.localhost (open http://admin.localhost:3000)
ADMIN_HOSTNAME=admin.localhost

# --- Optional: AI document reader (Claude on Amazon Bedrock, EU only) ---
# Set PLANNR_AI_READER=bedrock to enable it (empty = off). Even then, a firm owner has
# to switch it on under Instellingen. See README.md, "AI document reader".
# Names start with PLANNR_ because Vercel reserves AWS_REGION and AWS_* keys.
PLANNR_AI_READER=
PLANNR_AWS_REGION=eu-central-1
# Either a Bedrock API key ...
PLANNR_BEDROCK_API_KEY=
# ... or an IAM access key pair:
PLANNR_AWS_ACCESS_KEY_ID=
PLANNR_AWS_SECRET_ACCESS_KEY=
# Optional overrides:
# PLANNR_BEDROCK_MODEL=anthropic.claude-opus-5-5
# PLANNR_BEDROCK_FALLBACK_MODEL=anthropic.claude-opus-4-8   ("none" to disable)
