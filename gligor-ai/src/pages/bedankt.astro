---
import Base from "../layouts/Base.astro";
import Logo from "../components/Logo.astro";
---
<Base title="Bedankt · Gligor.ai" description="Je bericht is binnen." noindex>
  <main id="main" class="hero-bg flex min-h-screen flex-col items-center justify-center px-4 text-center">
    <Logo class="h-9 w-auto" />
    <h1 class="mt-10 text-3xl font-bold">Dank je wel!</h1>
    <p class="mt-3 max-w-md text-muted">Je bericht is binnen. Ik reageer binnen één werkdag.</p>
    <a href="/" class="btn btn-primary mt-8">Terug naar de homepage</a>
  </main>
</Base>
