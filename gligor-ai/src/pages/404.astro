---
import Base from "../layouts/Base.astro";
import Logo from "../components/Logo.astro";
---
<Base title="Pagina niet gevonden · Gligor.ai" noindex>
  <main id="main" class="hero-bg flex min-h-screen flex-col items-center justify-center px-4 text-center">
    <Logo class="h-9 w-auto" />
    <h1 class="mt-10 text-3xl font-extrabold">Deze pagina bestaat niet (meer).</h1>
    <p class="mt-3 text-muted">Geen zorgen, je bent zo weer terug.</p>
    <a href="/" class="btn btn-primary mt-8">Naar de homepage</a>
  </main>
</Base>
