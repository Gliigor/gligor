---
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import PainPoints from "../components/PainPoints.astro";
import Demo from "../components/Demo.astro";
import Services from "../components/Services.astro";
import Calculator from "../components/Calculator.astro";
import Pricing from "../components/Pricing.astro";
import Guarantee from "../components/Guarantee.astro";
import Steps from "../components/Steps.astro";
import About from "../components/About.astro";
import Trust from "../components/Trust.astro";
import Faq from "../components/Faq.astro";
import Booking from "../components/Booking.astro";
import Footer from "../components/Footer.astro";
import { SHOW_TRUST_SECTION } from "../config";
---
<Base>
  <Header />
  <main id="main">
    <Hero />
    <PainPoints />
    <Demo />
    <Services />
    <Calculator />
    <Pricing />
    <Guarantee />
    <Steps />
    <About />
    {SHOW_TRUST_SECTION && <Trust />}
    <Faq />
    <Booking />
  </main>
  <Footer />
</Base>

<script>
  import { initReveal } from "../scripts/reveal";
  initReveal();
</script>
