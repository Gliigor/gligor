---
import Icon from "./Icon.astro";

/*
 * Korte "video's" bij "Herken je dit?", als animatie in de pagina zelf (geen
 * videobestanden): scherp op elk scherm, licht én donker, en direct geladen.
 * Volgorde = volgorde van de pijnpunten in PainPoints.astro. De tijdlijn per
 * clip staat in src/scripts/clips.ts.
 */
const textClips = [
  { index: 2, from: "32 bonnetjes", to: "1 nette tabel", sub: "In 8 minuten, totalen gecontroleerd." },
  { index: 3, from: "Een week aan posts", to: "in 20 minuten", sub: "In jouw toon, klaar om in te plannen." },
  { index: 4, from: "12 nieuwe reviews", to: "allemaal beantwoord", sub: "Persoonlijk, in 2 minuten per stuk." },
  { index: 5, from: "38 nieuwe mails", to: "5 die jou nodig hebben", sub: "De rest gesorteerd, antwoorden voorbereid." },
];
---
<div class="clips reveal" style="--delay: 140ms" data-clips aria-hidden="true">
  <!-- 0. Offertes -->
  <div class="clip clip-quote" data-clip="0" data-duration="8800">
    <div class="q-title">
      <p class="k-big">Elke avond<br />offertes typen?</p>
    </div>
    <span class="q-timer"><Icon name="Clock" class="size-[1em]" stroke={2} /><span class="q-timer-a">45 min</span><span class="q-timer-b">5 min</span></span>
    <div class="q-work">
      <div class="q-notes">
        <p class="q-label">Jouw aantekeningen</p>
        <p class="q-note" data-type="Badkamer Jansen, 6 m²"></p>
        <p class="q-note" data-type="Tegels + kitwerk"></p>
        <p class="q-note" data-type="Start week 12"></p>
      </div>
      <div class="q-arrow"><Icon name="Sparkles" class="size-[1.1em]" stroke={2} /></div>
      <div class="q-doc">
        <div class="q-doc-head">
          <span class="q-logo">Offerte</span>
          <span class="q-no">#2026-041 · Fam. Jansen</span>
        </div>
        <div class="q-row q-r1"><span>Tegelwerk badkamer, 6 m²</span><b>€ 540,00</b></div>
        <div class="q-row q-r2"><span>Kitwerk en afwerking</span><b>€ 85,00</b></div>
        <div class="q-row q-r3"><span>Materiaal (tegels, lijm, kit)</span><b>€ 310,00</b></div>
        <div class="q-tot">
          <div><span>Totaal excl. btw</span><span>€ 935,00</span></div>
          <div><span>Btw 21%</span><span>€ 196,35</span></div>
          <div class="q-grand"><span>Totaal</span><span>€ 1.131,35</span></div>
        </div>
        <span class="q-stamp"><Icon name="Check" class="size-[1em]" stroke={2.5} /> Klaar om te versturen</span>
      </div>
    </div>
    <div class="q-final">
      <p class="k-mid">Van <s>45</s> naar <em>5 minuten</em>.</p>
      <p class="k-sub">Jij leest hem na en verstuurt.</p>
    </div>
  </div>

  <!-- 1. WhatsApp -->
  <div class="clip clip-chat" data-clip="1" data-duration="10200">
    <div class="w-title">
      <span class="w-clock">22:14</span>
      <p class="k-big">Klanten appen<br />'s avonds?</p>
    </div>
    <div class="w-side w-side-l"><span class="w-chip"><Icon name="Sparkles" class="size-[1em]" stroke={2} /> AI stelt een antwoord voor</span></div>
    <div class="w-side w-side-r"><span class="w-chip"><span class="w-slash">/</span> Vaste antwoorden met één commando</span></div>
    <div class="w-phone">
      <div class="w-head">
        <span class="w-avatar">LV</span>
        <span class="w-who"><b>Lisa van Dijk</b><small>online</small></span>
      </div>
      <div class="w-msgs">
        <div class="w-msg in w-m1"><p>Hoi! Wat kost knippen + föhnen? En kan ik zaterdag nog terecht?</p><time>22:14</time></div>
        <div class="w-msg out w-m2"><p>Hoi Lisa! Knippen + föhnen kost € 38. Zaterdag hebben we nog plek om 10:30 en 14:00. Zal ik er een voor je vastzetten?</p><time>22:14 ✓✓</time></div>
        <div class="w-msg in w-m3"><p>14:00 graag! Waar kan ik parkeren?</p><time>22:15</time></div>
        <div class="w-msg out w-m4"><p>Top, je staat erin! Je parkeert gratis op het plein voor de deur.</p><time>22:15 ✓✓</time></div>
      </div>
      <div class="w-suggest">
        <p class="w-suggest-label"><Icon name="Sparkles" class="size-[1em]" stroke={2} /> AI-voorstel · uit jouw prijslijst en agenda</p>
        <p class="w-suggest-text">Hoi Lisa! Knippen + föhnen kost € 38. Zaterdag hebben we nog plek om 10:30 en 14:00. Zal ik er een voor je vastzetten?</p>
        <span class="w-send-btn">Versturen</span>
      </div>
      <div class="w-cmds">
        <p class="w-cmd is-hit"><b>/parkeren</b><span>Gratis parkeren op het plein…</span></p>
        <p class="w-cmd"><b>/prijzen</b><span>Knippen € 32, föhnen € 6…</span></p>
        <p class="w-cmd"><b>/openingstijden</b><span>Di–za 9:00–17:30…</span></p>
      </div>
      <div class="w-input"><span class="w-typed" data-type="/park"></span><span class="w-caret"></span></div>
    </div>
    <div class="w-final">
      <p class="k-mid">Twee antwoorden. <em>Tien seconden.</em></p>
      <p class="k-sub">Binnen jouw regels: alleen prijzen en tijden die jij hebt vastgelegd.</p>
    </div>
  </div>

  {textClips.map((c) => (
    <div class="clip clip-text" data-clip={c.index} data-duration="4800">
      <p class="t-from">{c.from}</p>
      <p class="t-arrow"><Icon name="ArrowDown" class="size-[1em]" stroke={2} /></p>
      <p class="t-to">{c.to}</p>
      <p class="t-sub">{c.sub}</p>
    </div>
  ))}

  <span class="clips-tag">Voorbeeld</span>
  <span class="clips-bar"><i></i></span>
</div>

<style>
  /* ---------- Speler ---------- */
  .clips {
    position: relative;
    container-type: inline-size;
    aspect-ratio: 16 / 9;
    width: 100%;
    margin: 2.25rem auto 0;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: 20px;
    background:
      radial-gradient(60% 70% at 85% 0%, color-mix(in srgb, var(--brand) 10%, transparent), transparent 70%),
      var(--surface);
    text-align: left;
    cursor: default;
  }
  @media (max-width: 639px) {
    .clips { aspect-ratio: 4 / 5; }
  }
  .clip {
    position: absolute;
    inset: 0;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.35s ease, visibility 0s linear 0.35s;
  }
  .clip.is-on {
    opacity: 1;
    visibility: visible;
    transition: opacity 0.35s ease, visibility 0s;
  }
  .clips-tag {
    position: absolute;
    right: 14px;
    bottom: 12px;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .clips-bar {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 3px;
    background: color-mix(in srgb, var(--line) 70%, transparent);
  }
  .clips-bar i {
    display: block;
    height: 100%;
    width: 100%;
    background: var(--brand);
    transform-origin: left;
    transform: scaleX(0);
  }
  .clips.is-playing .clips-bar i {
    animation: clip-progress var(--clip-ms, 5000ms) linear forwards;
  }
  @keyframes clip-progress { to { transform: scaleX(1); } }

  /* Gedeelde typografie: groot, strak, en het mag groeien en krimpen. */
  .k-big {
    margin: 0;
    font-size: clamp(1.9rem, 7.2cqw, 4.2rem);
    line-height: 1.02;
    font-weight: 800;
    letter-spacing: -0.04em;
    color: var(--fg);
  }
  .k-mid {
    margin: 0;
    font-size: clamp(1.6rem, 5.4cqw, 3rem);
    line-height: 1.05;
    font-weight: 800;
    letter-spacing: -0.035em;
    color: var(--fg);
  }
  .k-mid em { font-style: italic; color: var(--accent); }
  .k-mid s { text-decoration-thickness: 0.08em; color: var(--muted); }
  .k-sub { margin: 0.6em 0 0; font-size: clamp(0.85rem, 2cqw, 1.1rem); color: var(--muted); font-weight: 500; }

  /* Alles wat in een clip verschijnt, beweegt met dezelfde soepele curve. */
  .clip * { transition-timing-function: cubic-bezier(0.22, 1, 0.36, 1); }
  .clip.no-anim, .clip.no-anim * { transition: none !important; }

  /* ---------- 0. Offertes ---------- */
  .q-title, .q-final, .w-title, .w-final {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 6%;
    transition: opacity 0.5s, transform 0.7s;
  }
  .q-title { opacity: 0; transform: scale(1.18); }
  .clip-quote.s1 .q-title { opacity: 1; transform: scale(1); }
  .clip-quote.s2 .q-title { opacity: 0; transform: scale(0.55) translateY(-40%); }

  .q-timer {
    position: absolute;
    top: 5%;
    right: 4%;
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    padding: 0.35em 0.75em;
    border-radius: 999px;
    border: 1px solid var(--line);
    background: var(--bg);
    font-size: clamp(0.75rem, 1.8cqw, 1rem);
    font-weight: 700;
    color: var(--fg);
    opacity: 0;
    transform: translateY(-8px);
    transition: opacity 0.4s, transform 0.5s, background-color 0.4s, color 0.4s, border-color 0.4s;
  }
  .q-timer-b { display: none; }
  .clip-quote.s1 .q-timer { opacity: 1; transform: none; }
  .clip-quote.s9 .q-timer { background: var(--brand); color: var(--brand-fg); border-color: transparent; transform: scale(1.12); }
  .clip-quote.s9 .q-timer-a { display: none; }
  .clip-quote.s9 .q-timer-b { display: inline; }
  .clip-quote.s10 .q-timer { opacity: 0; }

  .q-work {
    position: absolute;
    inset: 15% 4% 9%;
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) auto minmax(0, 1.25fr);
    align-items: center;
    gap: 3%;
    opacity: 0;
    transition: opacity 0.5s, transform 0.6s, filter 0.5s;
  }
  .clip-quote.s2 .q-work { opacity: 1; }
  .clip-quote.s10 .q-work { opacity: 0.12; transform: scale(0.96); filter: blur(2px); }

  .q-notes {
    align-self: center;
    border: 1px dashed var(--line);
    border-radius: 14px;
    padding: 6% 7%;
    background: var(--mist);
    font-size: clamp(0.72rem, 1.9cqw, 1.05rem);
    transform: translateX(-12px);
    opacity: 0;
    transition: opacity 0.45s, transform 0.55s;
  }
  .clip-quote.s3 .q-notes { opacity: 1; transform: none; }
  .q-label { margin: 0 0 0.5em; font-size: 0.78em; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: var(--muted); }
  .q-note { margin: 0.25em 0; min-height: 1.4em; font-weight: 600; color: var(--fg); font-style: italic; }

  .q-arrow {
    display: flex;
    align-items: center;
    justify-content: center;
    width: clamp(28px, 6cqw, 48px);
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--brand);
    color: var(--brand-fg);
    font-size: clamp(0.9rem, 2.4cqw, 1.4rem);
    opacity: 0;
    transform: scale(0.4) rotate(-40deg);
    transition: opacity 0.4s, transform 0.6s;
  }
  .clip-quote.s4 .q-arrow { opacity: 1; transform: none; animation: q-pulse 1.1s ease-in-out 0.4s 2; }
  @keyframes q-pulse { 50% { transform: scale(1.15); } }

  .q-doc {
    position: relative;
    border: 1px solid var(--line);
    border-radius: 14px;
    background: var(--bg);
    padding: 5% 6%;
    font-size: clamp(0.66rem, 1.7cqw, 0.95rem);
    box-shadow: 0 18px 40px -24px rgb(0 0 0 / 0.35);
    opacity: 0;
    transform: translateY(14px) scale(0.97);
    transition: opacity 0.45s, transform 0.6s;
  }
  .clip-quote.s4 .q-doc { opacity: 1; transform: none; }
  .q-doc-head { display: flex; align-items: baseline; justify-content: space-between; gap: 0.6em; border-bottom: 2px solid var(--fg); padding-bottom: 0.5em; margin-bottom: 0.4em; }
  .q-logo { font-weight: 800; font-size: 1.35em; letter-spacing: -0.02em; color: var(--fg); }
  .q-no { color: var(--muted); font-size: 0.85em; white-space: nowrap; }
  .q-row, .q-tot > div { display: flex; justify-content: space-between; gap: 1em; }
  .q-row { padding: 0.45em 0; border-bottom: 1px solid var(--line); color: var(--ink); opacity: 0; transform: translateX(10px); transition: opacity 0.35s, transform 0.45s, background-color 0.6s; }
  .q-row b { color: var(--fg); font-variant-numeric: tabular-nums; white-space: nowrap; }
  .clip-quote.s5 .q-r1, .clip-quote.s6 .q-r2, .clip-quote.s7 .q-r3 { opacity: 1; transform: none; }
  .q-tot { margin-top: 0.5em; opacity: 0; transition: opacity 0.4s; font-variant-numeric: tabular-nums; color: var(--muted); }
  .q-tot > div { padding: 0.15em 0; }
  .q-grand { margin-top: 0.2em; padding-top: 0.35em !important; border-top: 1px solid var(--line); font-weight: 800; color: var(--fg); font-size: 1.15em; }
  .clip-quote.s8 .q-tot { opacity: 1; }
  .q-stamp {
    position: absolute;
    right: -4%;
    bottom: -9%;
    display: inline-flex;
    align-items: center;
    gap: 0.35em;
    padding: 0.45em 0.85em;
    border-radius: 999px;
    background: var(--brand);
    color: var(--brand-fg);
    font-weight: 800;
    white-space: nowrap;
    opacity: 0;
    transform: scale(1.6) rotate(-6deg);
    transition: opacity 0.25s, transform 0.45s cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  .clip-quote.s9 .q-stamp { opacity: 1; transform: rotate(-4deg); }

  .q-final { opacity: 0; transform: scale(0.85); }
  .clip-quote.s10 .q-final { opacity: 1; transform: none; }

  @container (max-width: 520px) {
    .q-work { inset: 16% 6% 10%; grid-template-columns: minmax(0, 1fr); grid-template-rows: auto auto minmax(0, 1fr); gap: 4%; align-items: start; }
    .q-arrow { justify-self: center; transform: rotate(90deg) scale(0.4); }
    .clip-quote.s4 .q-arrow { transform: rotate(90deg); animation: none; }
    .q-notes { font-size: 0.8rem; padding: 4% 5%; }
    .q-doc { font-size: 0.74rem; }
    .q-stamp { right: 4%; bottom: -6%; }
  }

  /* ---------- 1. WhatsApp ---------- */
  .w-title { opacity: 0; transform: scale(1.18); }
  .clip-chat.s1 .w-title { opacity: 1; transform: none; }
  .clip-chat.s2 .w-title { opacity: 0; transform: scale(0.55) translateY(-40%); }
  .w-clock {
    margin-bottom: 0.4em;
    font-size: clamp(0.9rem, 2.4cqw, 1.3rem);
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    color: var(--accent);
  }

  .w-phone {
    position: absolute;
    top: 7%;
    bottom: 7%;
    left: 0;
    right: 0;
    margin-inline: auto;
    width: min(46%, 360px);
    display: flex;
    flex-direction: column;
    border: 1px solid var(--line);
    border-radius: 22px;
    background: var(--mist);
    overflow: hidden;
    font-size: clamp(0.68rem, 1.65cqw, 0.92rem);
    box-shadow: 0 24px 50px -28px rgb(0 0 0 / 0.45);
    opacity: 0;
    transform: translateY(24px) scale(0.96);
    transition: opacity 0.45s, transform 0.6s, filter 0.5s;
  }
  .clip-chat.s2 .w-phone { opacity: 1; transform: none; }
  .clip-chat.s11 .w-phone { opacity: 0.14; transform: scale(0.96); filter: blur(2px); }
  .w-head { display: flex; align-items: center; gap: 0.6em; padding: 0.7em 0.9em; background: var(--surface); border-bottom: 1px solid var(--line); }
  .w-avatar { display: grid; place-items: center; width: 2.2em; height: 2.2em; border-radius: 50%; background: color-mix(in srgb, var(--brand) 25%, var(--surface)); color: var(--fg); font-weight: 800; font-size: 0.85em; }
  .w-who { display: flex; flex-direction: column; line-height: 1.15; }
  .w-who b { color: var(--fg); }
  .w-who small { color: var(--muted); font-size: 0.8em; }

  .w-msgs { flex: 1; display: flex; flex-direction: column; justify-content: flex-end; gap: 0; padding: 0.6em 0.75em; overflow: hidden; }
  .w-msg {
    max-width: 84%;
    max-height: 0;
    margin: 0;
    padding: 0 0.75em;
    border-radius: 12px;
    opacity: 0;
    overflow: hidden;
    transform: translateY(8px);
    transition: max-height 0.45s, opacity 0.35s, transform 0.45s, margin 0.45s, padding 0.45s;
  }
  .w-msg p { margin: 0; color: var(--fg); line-height: 1.35; }
  .w-msg time { display: block; margin-top: 0.15em; text-align: right; font-size: 0.75em; color: var(--muted); }
  .w-msg.in { align-self: flex-start; background: var(--surface); border: 1px solid var(--line); border-top-left-radius: 4px; }
  .w-msg.out { align-self: flex-end; background: color-mix(in srgb, var(--brand) 26%, var(--surface)); border-top-right-radius: 4px; }
  .clip-chat.s3 .w-m1, .clip-chat.s6 .w-m2, .clip-chat.s7 .w-m3, .clip-chat.s10 .w-m4 {
    max-height: 12em;
    margin-top: 0.45em;
    padding: 0.5em 0.75em;
    opacity: 1;
    transform: none;
  }

  .w-suggest {
    margin: 0 0.6em;
    max-height: 0;
    padding: 0 0.8em;
    border-radius: 12px;
    border: 1px solid transparent;
    background: var(--surface);
    overflow: hidden;
    opacity: 0;
    transition: max-height 0.5s, padding 0.5s, opacity 0.35s, margin 0.5s, border-color 0.3s;
  }
  .clip-chat.s4 .w-suggest { max-height: 14em; padding: 0.65em 0.8em; margin-bottom: 0.5em; opacity: 1; border-color: color-mix(in srgb, var(--accent) 45%, transparent); }
  .clip-chat.s6 .w-suggest { max-height: 0; padding: 0 0.8em; margin-bottom: 0; opacity: 0; border-color: transparent; }
  .w-suggest-label { display: flex; align-items: center; gap: 0.35em; margin: 0 0 0.35em; font-size: 0.78em; font-weight: 700; color: var(--accent); }
  .w-suggest-text {
    margin: 0;
    color: var(--fg);
    line-height: 1.35;
    clip-path: inset(0 100% 0 0);
    transition: clip-path 0.9s steps(28);
  }
  .clip-chat.s4 .w-suggest-text { clip-path: inset(0 0 0 0); transition-delay: 0.25s; }
  .w-send-btn {
    display: inline-block;
    margin-top: 0.5em;
    padding: 0.3em 0.9em;
    border-radius: 999px;
    background: var(--brand);
    color: var(--brand-fg);
    font-weight: 800;
    font-size: 0.85em;
    transition: transform 0.15s;
  }
  .clip-chat.s5 .w-send-btn { transform: scale(0.88); box-shadow: 0 0 0 5px color-mix(in srgb, var(--brand) 30%, transparent); }

  .w-cmds {
    margin: 0 0.6em;
    max-height: 0;
    border-radius: 12px;
    background: var(--surface);
    border: 1px solid transparent;
    overflow: hidden;
    opacity: 0;
    transition: max-height 0.4s, opacity 0.3s, margin 0.4s, border-color 0.3s;
  }
  .clip-chat.s8 .w-cmds { max-height: 10em; margin-bottom: 0.45em; opacity: 1; border-color: var(--line); }
  .clip-chat.s10 .w-cmds { max-height: 0; margin-bottom: 0; opacity: 0; border-color: transparent; }
  .w-cmd { display: flex; gap: 0.6em; margin: 0; padding: 0.45em 0.75em; border-bottom: 1px solid var(--line); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .w-cmd:last-child { border-bottom: 0; }
  .w-cmd b { color: var(--accent); }
  .w-cmd span { color: var(--muted); overflow: hidden; text-overflow: ellipsis; }
  .clip-chat.s9 .w-cmd.is-hit { background: color-mix(in srgb, var(--brand) 22%, transparent); }

  .w-input { display: flex; align-items: center; margin: 0 0.6em 0.7em; padding: 0.55em 0.85em; border-radius: 999px; background: var(--surface); border: 1px solid var(--line); min-height: 2.4em; color: var(--fg); font-weight: 600; }
  .w-caret { width: 2px; height: 1.1em; margin-left: 1px; background: var(--accent); animation: w-blink 0.9s steps(1) infinite; }
  @keyframes w-blink { 50% { opacity: 0; } }

  .w-side {
    position: absolute;
    top: 50%;
    width: 24%;
    display: flex;
    opacity: 0;
    transition: opacity 0.4s, transform 0.5s;
  }
  .w-side-l { left: 3%; justify-content: flex-end; transform: translate(-10px, -50%); }
  .w-side-r { right: 3%; justify-content: flex-start; transform: translate(10px, -50%); }
  .clip-chat.s4 .w-side-l { opacity: 1; transform: translate(0, -50%); }
  .clip-chat.s8 .w-side-r { opacity: 1; transform: translate(0, -50%); }
  .clip-chat.s11 .w-side { opacity: 0; }
  .w-chip { display: inline-flex; align-items: center; gap: 0.45em; padding: 0.55em 0.85em; border-radius: 12px; background: var(--bg); border: 1px solid var(--line); font-size: clamp(0.7rem, 1.6cqw, 0.92rem); font-weight: 700; color: var(--fg); line-height: 1.25; }
  .w-slash { display: grid; place-items: center; width: 1.5em; height: 1.5em; border-radius: 6px; background: var(--brand); color: var(--brand-fg); font-weight: 800; }

  .w-final { opacity: 0; transform: scale(0.85); }
