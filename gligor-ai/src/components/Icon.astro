---
import * as lucide from "lucide-static";
import { siWhatsapp } from "simple-icons";

interface Props {
  name: string;
  class?: string;
  /** Lijndikte voor lucide-iconen. */
  stroke?: number;
}
const { name, class: className = "size-6", stroke = 1.75 } = Astro.props;

const brands: Record<string, string> = {
  whatsapp: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"><path d="${siWhatsapp.path}"/></svg>`,
  linkedin: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"><path d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.34V9h3.42v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28ZM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13ZM7.12 20.45H3.56V9h3.56v11.45ZM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0Z"/></svg>`,
};

let svg = brands[name] ?? (lucide as Record<string, string>)[name];
if (!svg) throw new Error(`Onbekend icoon: ${name}`);
svg = svg
  .replace(/\swidth="24"/, "")
  .replace(/\sheight="24"/, "")
  .replace(/stroke-width="2"/, `stroke-width="${stroke}"`)
  .replace(/class="[^"]*"/, "")
  .replace("<svg", `<svg class="${className}" aria-hidden="true" focusable="false"`);
---
<Fragment set:html={svg} />
