---
import Logo from "./Logo.astro";

const links = [
  { href: "#demo", label: "Demo" },
  { href: "#diensten", label: "Diensten" },
  { href: "#besparing", label: "Besparing" },
  { href: "#prijs", label: "Prijs" },
  { href: "#vragen", label: "Vragen" },
];
---
<header id="site-header" class="site-header fixed inset-x-0 top-0 z-50 border-b border-transparent">
  <div class="container-page flex h-16 items-center justify-between gap-4 sm:h-[4.5rem]">
    <a href="/#top" class="shrink-0 rounded-md" aria-label="gligor.ai, naar boven">
      <Logo class="h-[26px] w-auto sm:h-[30px]" />
    </a>
    <nav aria-label="Hoofdmenu" class="hidden lg:block">
      <ul class="flex items-center gap-1 text-[15px] font-medium text-ink">
        {links.map((l) => (
          <li><a href={`/${l.href}`} class="rounded-lg px-3 py-2 transition-colors hover:bg-mist hover:text-navy">{l.label}</a></li>
        ))}
      </ul>
    </nav>
    <a href="/#kennismaken" class="btn btn-primary whitespace-nowrap px-3.5 py-2.5 text-sm sm:px-5 sm:text-[15px]">
      Plan een kennismaking
    </a>
  </div>
</header>

<script>
  const header = document.getElementById("site-header");
  if (header) {
    const update = () => header.classList.toggle("is-scrolled", window.scrollY > 8);
    update();
    window.addEventListener("scroll", update, { passive: true });
  }
</script>
