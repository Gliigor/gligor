---
import logo from "./logo-data.json";

interface Props {
  class?: string;
  /** "auto" = volgt het thema (donker op licht, licht op donker); "light" = altijd lichte letters (op een donker vlak). */
  tone?: "auto" | "light";
}
const { class: className = "h-7 w-auto", tone = "auto" } = Astro.props;
---
<!-- Woordmerk: "gligor" cursief, ".ai" groen en cursief (zelfde als admin.gligor.ai). -->
<svg class:list={[className, "logo", tone === "light" && "logo-light"]} viewBox={logo.viewBox} xmlns="http://www.w3.org/2000/svg" role="img" aria-label="gligor.ai">
  <path class="logo-word" d={logo.word} />
  <path class="logo-tld" d={logo.tld} />
</svg>

<style>
  .logo .logo-word { fill: var(--fg); }
  .logo .logo-tld { fill: var(--accent); }
  .logo-light .logo-word { fill: #ededed; }
  .logo-light .logo-tld { fill: #3ee08f; }
</style>
